# GCP Service Account Credentials
# Paste your complete service account JSON key here (as a single line JSON string)
# You can get this from: GCP Console > IAM & Admin > Service Accounts > [Your Service Account] > Keys
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# GCP Project Configuration (Optional - can be overridden in API payload)
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ORG_ID=your-org-id

# Pulumi Configuration
# Paths are relative to the project root, or use absolute paths
PULUMI_STATE_DIR=C:\jahanzaib-git\gcp_infra_composer_full\pulumi-state
PULUMI_HOME_DIR=C:\jahanzaib-git\gcp_infra_composer_full\.pulumi-home
PULUMI_WORK_DIR=C:\jahanzaib-git\gcp_infra_composer_full\pulumi-work
PULUMI_CONFIG_PASSPHRASE=dev-passphrase

# Pulumi CLI Path (Optional - auto-detected if Pulumi is in PATH)
# Only set this if Pulumi is installed in a non-standard location
# PULUMI_CLI_PATH=C:\Program Files (x86)\Pulumi
